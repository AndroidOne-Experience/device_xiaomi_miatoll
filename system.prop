# Audio
audio.offload.min.duration.secs=30

# Blur
ro.launcher.blur.appLaunch=0
ro.surface_flinger.supports_background_blur=0
ro.sf.blurs_are_expensive=1
persist.sys.sf.disable_blurs=true
enable_blurs_on_windows=0
disableBlurs=true
ro.sf.blurs_are_caro=1
ro.miui.has_real_blur=0
persist.sys.background_blur_supported=false

# Camera
persist.sys.cam.skip_detach_image=true

# CNE
persist.vendor.cne.feature=1

# Display
debug.sf.enable_hwc_vds=1

# DPM
persist.vendor.dpm.feature=11

# Framework allowlists
persist.vendor.camera.privapp.list=com.android.camera
vendor.camera.aux.packagelist=com.android.camera

# Filesystem
fs_mgr.overlayfs.prefer_cache_backing_storage=true

# FUSE
persist.sys.fuse.passthrough.enable=true

# Fwk detect
ro.vendor.qti.va_aosp.support=1

# Google Lens
ro.com.google.lens.oem_camera_package=com.android.camera

# IMS
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.vendor.qti.telephony.vt_cam_interface=2
persist.vendor.radio.report_codec=1
persist.vendor.radio.vdp_on_ims_cap=1
persist.vendor.ims.disableADBLogs=1
persist.vendor.ims.disableDebugLogs=1
persist.vendor.ims.disableIMSLogs=1
persist.vendor.ims.disableQXDMLogs=1
persist.sys.radio.force_lte_ca=true

# Log
persist.log.tag.audio_hw_primary=S

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true
ro.media.recorder-max-base-layer-fps=60
persist.mm.enable.prefetch=true
# Codecs enabled: AAC, AC3 (Dolby), AMR_NB, AMR_WB, ASF, AVI, DTS, 3GP, 3G2, MKV, MP2PS, MP2TS, MP3, OGG, QCP, WAV, FLAC, AIFF, APE, DSD, MOV, MHAS
# Disabled: FLV
vendor.mm.enable.qcom_parser=16777311
media.stagefright.enable-player=true
media.stagefright.enable-http=true
media.stagefright.enable-aac=true
media.stagefright.enable-qcp=true
media.stagefright.enable-fma2dp=true
media.stagefright.enable-scan=true
media.aac_51_output_enabled=true
persist.mm.enable.prefetch=true

# MiuiCamera
ro.miui.build.region=in
ro.miui.notch=1
ro.product.mod_device=_global

# Pre-Rendering
ro.vendor.perf.scroll_opt=true

# Render
debug.cpurend.vsync=false

# Disable Skia tracing by default
debug.hwui.skia_atrace_enabled=false

# Telephony
persist.vendor.ims.disableADBLogs=1
persist.vendor.ims.disableDebugLogs=1
persist.vendor.ims.disableIMSLogs=1
persist.vendor.ims.disableQXDMLogs=1

# WFD
persist.debug.wfd.enable=1
vendor.sys.video.disable.ubwc=1

# disable logs spam
audio.offload.min.duration.secs=30
persist.vendor.cne.feature=1
debug.performance.tuning=1
persist.vendor.dpm.feature=11
fs_mgr.overlayfs.prefer_cache_backing_storage=true
ro.vendor.qti.va_aosp.support=1
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.vendor.ims.disableADBLogs=1
persist.vendor.ims.disableDebugLogs=1
persist.vendor.ims.disableIMSLogs=1
persist.vendor.ims.disableQXDMLogs=1